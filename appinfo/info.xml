<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>kidseye</id>
	<name>kidseye</name>
	<summary>Schülerbeobachtung für die Grundschule</summary>
	<description><![CDATA[
Beobachtungen zu einzelnen Kindern in Sekunden erfassen, automatisch an das
hessische Kerncurriculum binden und daraus Belege für Elterngespräch,
Zeugnis und Förderplan gewinnen.

Erfassen und Einschätzen sind getrennt: im Unterricht wird nur festgehalten.
Die pädagogische Einschätzung trifft die Lehrkraft — kidseye erzeugt keine
Noten, keine Einstufungen und keine automatischen Bewertungen.
	]]></description>
	<version>0.1.0</version>
	<licence>agpl</licence>
	<author>Johannes Brötzens</author>
	<namespace>KidsEye</namespace>

	<category>tools</category>
	<category>office</category>

	<bugs>https://github.com/foe05/kidseye/issues</bugs>

	<!--
		max-version ist im Schema Pflicht (info.xsd: use="required"), lässt sich
		also nicht weglassen. Der Wert ist gegen die Critical Changes von
		Nextcloud 34 und 35 geprüft: keine der dort entfernten Klassen, Methoden
		oder Frontend-APIs wird hier benutzt. Für 36 liegen noch keine
		Änderungslisten vor; bis dahin hilft die Option "force" beim
		Aktivieren über occ.

		Hinweis: Nextcloud 35 verlangt serverseitig PHP 8.3. Die App selbst
		kommt mit 8.1 aus.
	-->
	<dependencies>
		<php min-version="8.1" />
		<nextcloud min-version="30" max-version="35" />
	</dependencies>

	<commands>
		<command>OCA\KidsEye\Command\RahmenImportieren</command>
		<command>OCA\KidsEye\Command\RahmenAuflisten</command>
		<command>OCA\KidsEye\Command\Einrichten</command>
		<command>OCA\KidsEye\Command\Pruefen</command>
		<command>OCA\KidsEye\Command\Beispieldaten</command>
	</commands>

	<navigations>
		<navigation>
			<id>kidseye</id>
			<name>kidseye</name>
			<route>kidseye.page.index</route>
			<icon>app.svg</icon>
			<order>10</order>
		</navigation>
	</navigations>
</info>
