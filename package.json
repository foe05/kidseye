    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/webpack-vue-config": "^6.0.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.0",
    "terser-webpack-plugin": "^5.3.11",
    "vue-loader": "^15.11.1",
    "vitest": "^1.6.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^6.0.1"
  },
  "browserslist": [
